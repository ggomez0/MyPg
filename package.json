{
  "name": "mypg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "landing:dev": "pnpm --filter @mypg/landing dev",
    "landing:build": "pnpm --filter @mypg/landing build",
    "landing:start": "pnpm --filter @mypg/landing start",
    "landing:test": "pnpm --filter @mypg/landing test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
